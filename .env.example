# Public browser configuration. Obtain this value from the Dynamic dashboard.
VITE_DYNAMIC_ENVIRONMENT_ID=

# Cloudflare Pages Function secrets. Set these with `wrangler pages secret put`;
# do not put them in a Vite environment file or GitHub repository variables.
# ACROSS_API_KEY=
# ACROSS_INTEGRATOR_ID=

# Integrator fee (Pages Function secrets, synced from GitHub secrets on deploy).
# ACROSS_APP_FEE is a decimal fraction: 0.0025 = 0.25%. Charged once per swap,
# paid on the destination chain to the matching recipient.
# ACROSS_APP_FEE=
# ACROSS_FEE_RECIPIENT_EVM=
# ACROSS_FEE_RECIPIENT_SVM=
